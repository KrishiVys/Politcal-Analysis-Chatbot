# Copy everything below into: Streamlit Community Cloud -> your app -> Settings -> Secrets
# (or, to test locally, save it as .streamlit/secrets.toml -- never upload that file).
# Fill in the keys you have; leave out the ones you don't. Keep the quotes.

APP_PASSWORD = "choose-a-password"     # required to open the app once it's online

SARVAM_API_KEY = ""                    # needed for AI-written summaries
BRAVE_API_KEY = ""                     # optional: primary social-media search
X_BEARER_TOKEN = ""                    # optional: X / Twitter backup
YOUTUBE_API_KEY = ""                   # optional
META_ACCESS_TOKEN = ""                 # optional: Facebook/Instagram ad library
