# Copy this file to ".env" (same folder as updatedcode.py / the fact-check tools) and fill in
# whichever keys you have. Every line is optional -- the script skips any
# source whose key is missing. Delete the placeholder text for keys you
# don't have; do NOT leave real keys in a file named .env.example.
#
# IMPORTANT: once you create your real ".env" file, never share it, upload
# it, or commit it to version control -- it will contain your actual keys.

# Required for a written narrative (dashboard.sarvam.ai, free signup credits).
# Without this, you still get a report, just with a template summary instead
# of an AI-written one.
SARVAM_API_KEY=

# Optional. Primary social search across X/Instagram/Facebook/YouTube.
# brave.com/search/api -- check their site for current pricing/free tier.
BRAVE_API_KEY=

# Optional. Backup for X only, used when Brave finds too few X results.
# developer.x.com -- paid, pay-per-use, last 7 days only.
X_BEARER_TOKEN=

# Optional. YouTube video search with real date-range filtering.
# console.cloud.google.com -> enable "YouTube Data API v3" -> create a key.
# Free, ~100 searches/day.
YOUTUBE_API_KEY=

# Optional. Facebook/Instagram political ad activity (Ad Library API).
# developers.facebook.com -- free, but requires identity confirmation for
# political ads access. Covers ads only, not organic posts.
META_ACCESS_TOKEN=

# Optional. Used ONLY by the separate fact-check tools (video_factcheck.py /
# video_factcheck_app.py), not by the politician/party report tools above.
# Published fact-check ratings (Google Fact Check Tools API). Free:
# console.cloud.google.com -> enable "Fact Check Tools API" -> create a key.
# Without any key, the fact-check tool still works using fact-checker sites,
# just without structured ratings.
FACTCHECK_API_KEY=

# Optional. If set, the app asks for this password before it opens. Use it when the
# app is online (deployed), so other people can't run searches on your API keys.
APP_PASSWORD=
